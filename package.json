{
  "name": "cortico-world-private-companion",
  "version": "0.8.5",
  "type": "module",
  "description": "「我会永远陪着你」Coopanion 版：把原作的生活感、主动联系、关系卡与说话分寸独立实现为 World 扩展。内置可迁移记忆，支持本地图库导入与可选视觉自动描述，并打通记忆 × QQ × B站的多功能联动。",
  "keywords": [
    "cortico-world",
    "cortico",
    "coopanion",
    "companion",
    "persona",
    "proactive",
    "memory",
    "portable-memory",
    "memory-import",
    "qq",
    "im",
    "internet",
    "browser",
    "video",
    "external-setup",
    "high-cost",
    "unofficial-api"
  ],
  "author": "yaya-super",
  "license": "MIT",
  "homepage": "https://github.com/YaYa-super/cortico-world-private-companion",
  "engines": {
    "node": ">=22"
  },
  "main": "./src/index.ts",
  "cortico": {
    "kind": "world",
    "api": 6,
    "displayName": "我会永远陪着你",
    "icon": "assets/icon.png",
    "describe": "describe.json",
    "webUiClient": "src/webui/client.js",
    "tags": [
      "companion",
      "persona",
      "proactive",
      "life",
      "memory",
      "import-export",
      "migration",
      "qq",
      "im",
      "internet",
      "browser",
      "video",
      "external-setup",
      "high-cost",
      "unofficial-api"
    ]
  },
  "files": [
    "src",
    "assets",
    "describe.json",
    "ENV_PROMPT.md",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "test": "node --test",
    "describe": "node tools/gen-describe.mjs",
    "build:webui": "node tools/build-webui.mjs",
    "smoke": "node tools/smoke.ts",
    "prepublishOnly": "node tools/gen-describe.mjs && node tools/build-webui.mjs && node --test"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YaYa-super/cortico-world-private-companion.git"
  },
  "bugs": {
    "url": "https://github.com/YaYa-super/cortico-world-private-companion/issues"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "puppeteer-core": "^25.12.0",
    "ws": "^8.18.0"
  }
}
